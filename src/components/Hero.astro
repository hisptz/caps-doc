---
// Introduce CAPS alongside the climate-to-prediction workflow.
import { LinkButton } from '@astrojs/starlight/components';
import icon from '../assets/caps-icon.png';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<header class="banner">
	<div class="inner">
		<div class="introduction">
			<div class="brand">
				<img src={icon.src} alt="" width="48" height="48" class="logo" />
				{tagline && <p class="tagline" set:html={tagline} />}
			</div>
			<h1 id="_top" data-page-title set:html={title} />
			{data.description && <p class="lead">{data.description}</p>}
			{
				actions.length > 0 && (
					<div class="actions">
						{actions.map(({ link, text, variant, icon }) => (
							<LinkButton
								href={link}
								variant={variant}
								icon={icon?.name}
								class={variant === 'minimal' ? 'btn-ghost' : 'btn-solid'}
							>
								{text}
							</LinkButton>
						))}
					</div>
				)
			}
		</div>
		<figure class="workflow">
			<figcaption>The CAPS workflow</figcaption>
			<ol class="stages" role="list">
				<li class="stage">
					<div class="stage-visual" aria-hidden="true">
						<svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="49" cy="26" r="10" />
							<path d="M49 9V5m17 21h4M61 14l3-3M36 14l-3-3" />
							<path d="M22 49a12 12 0 0 1-1-24 16 16 0 0 1 30 5 10 10 0 0 1 2 19Z" class="cloud" />
							<path d="m26 57-3 7m15-7-3 7m15-7-3 7" />
						</svg>
					</div>
					<h2>Climate data</h2>
					<p>Sync the latest<br />climate observations.</p>
				</li>
				<li class="stage">
					<div class="stage-visual" aria-hidden="true">
						<svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14 15v50h54" />
							<path d="m21 51 12-13 11 6 19-23" />
							<path d="m44 44 19-7v-16Z" class="prediction-area" stroke="none" />
							<circle cx="33" cy="38" r="3" class="chart-point" />
							<circle cx="44" cy="44" r="3" class="chart-point" />
							<path d="m44 44 19-7" stroke-dasharray="3 5" />
						</svg>
					</div>
					<h2>CHAP predictions</h2>
					<p>Generate climate-informed<br />disease predictions.</p>
				</li>
				<li class="stage">
					<div class="stage-visual" aria-hidden="true">
						<svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<rect x="10" y="15" width="60" height="50" rx="5" />
							<path d="M10 27h60M20 21h1m6 0h1M21 54V43h9v11m6 0V35h9v19m6 0V39h9v15M20 54h41" />
						</svg>
					</div>
					<h2>DHIS2</h2>
					<p>Import results.<br />Update your dashboards.</p>
				</li>
			</ol>
			<p class="workflow-note">Connected by CAPS. Run on a schedule or on demand.</p>
		</figure>
	</div>
</header>

<style>
	.banner {
		/* Break out of the content column to span the whole window. */
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		margin-top: -1.5rem;
		padding: 4.5rem max(1.5rem, var(--sl-nav-pad-x)) 4rem;
		background: var(--caps-red);
		color: #fff;
		text-align: start;
	}
	.inner {
		max-width: 78rem;
		margin-inline: auto;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: 3rem;
	}
	.introduction {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
		max-width: 34rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.logo {
		width: 3rem;
		height: 3rem;
		flex-shrink: 0;
		border-radius: 0.75rem;
		border: 2px solid #fff;
	}
	h1 {
		margin: 0;
		font-size: clamp(2rem, 1.375rem + 2vw, 3rem);
		font-weight: 800;
		line-height: 1.1;
		color: #fff;
		text-wrap: balance;
	}
	.tagline {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		color: #fff;
	}
	.lead {
		margin: 0;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: rgb(255 255 255 / 0.9);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 0.75rem 1rem;
		margin-top: 0.75rem;
	}
	.actions :global(.btn-solid) {
		background: #fff;
		border-color: #fff;
		color: var(--caps-red);
		font-weight: 600;
	}
	.actions :global(.btn-ghost) {
		border: 1px solid rgb(255 255 255 / 0.7);
		color: #fff;
		padding-inline: 1.25rem;
		font-weight: 600;
	}
	.actions :global(a:hover) {
		background: #fbe3e2;
		border-color: #fbe3e2;
		color: #7a2221;
	}
	.actions :global(a:focus-visible) {
		outline: 3px solid #fff;
		outline-offset: 4px;
	}
	.workflow {
		--workflow-ink: #7a2221;
		--workflow-muted: #754d4b;
		--workflow-line: #d5aaa7;
		margin: 0;
		padding: 2rem 1.5rem;
		border-radius: 1rem;
		background: #fff8f6;
		color: var(--workflow-ink);
	}
	figcaption {
		font-size: 1rem;
		font-weight: 600;
	}
	.stages {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		list-style: none;
		margin: 2rem 0;
		padding: 0;
	}
	.stage {
		position: relative;
		min-width: 0;
		text-align: center;
	}
	.stage + .stage::before {
		content: '';
		position: absolute;
		inset-inline-start: -1.5rem;
		top: 2.5rem;
		width: 2rem;
		border-top: 1px solid var(--workflow-line);
	}
	.stage + .stage::after {
		content: '';
		position: absolute;
		inset-inline-start: 0.125rem;
		top: calc(2.5rem - 0.1875rem);
		width: 0.375rem;
		height: 0.375rem;
		border-top: 1px solid var(--workflow-line);
		border-right: 1px solid var(--workflow-line);
		transform: rotate(45deg);
	}
	.stage-visual {
		width: 5rem;
		height: 5rem;
		margin-inline: auto;
		color: var(--caps-red);
	}
	.stage-visual svg {
		display: block;
		width: 100%;
		height: 100%;
	}
	.cloud, .chart-point {
		fill: #fff8f6;
	}
	.prediction-area {
		fill: #f2d6d2;
	}
	.stage h2 {
		margin: 1rem 0 0;
		color: var(--workflow-ink);
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.4;
	}
	.stage p {
		margin: 0.5rem 0 0;
		color: var(--workflow-muted);
		font-size: 0.8125rem;
		line-height: 1.6;
	}
	.workflow-note {
		margin: 0;
		padding-top: 1rem;
		border-top: 1px solid var(--workflow-line);
		color: var(--workflow-muted);
		font-size: 0.8125rem;
		line-height: 1.6;
	}
	:global([data-theme='dark']) .workflow {
		--workflow-ink: #f6d5d1;
		--workflow-muted: #d9b5b1;
		--workflow-line: #78504e;
		background: #321b1b;
	}
	:global([data-theme='dark']) .stage-visual {
		color: #ef9690;
	}
	:global([data-theme='dark']) .cloud,
	:global([data-theme='dark']) .chart-point {
		fill: #321b1b;
	}
	:global([data-theme='dark']) .prediction-area {
		fill: #633431;
	}
	@media (min-width: 70rem) {
		.inner {
			grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		}
	}
	@media (max-width: 34.99rem) {
		.banner {
			padding-block: 2.5rem;
		}
		.workflow {
			padding: 1.5rem;
		}
		.stages {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.5rem;
			margin-block: 1.5rem;
		}
		.stage {
			display: grid;
			grid-template-columns: 4rem minmax(0, 1fr);
			column-gap: 1rem;
			align-items: center;
			text-align: start;
		}
		.stage-visual {
			grid-row: span 2;
			width: 4rem;
			height: 4rem;
		}
		.stage h2, .stage p {
			margin: 0;
		}
		.stage + .stage::before {
			inset-inline-start: 2rem;
			top: -2rem;
			width: 0;
			height: 1.5rem;
			border-top: 0;
			border-inline-start: 1px solid var(--workflow-line);
		}
		.stage + .stage::after {
			inset-inline-start: calc(2rem - 0.1875rem);
			top: -0.875rem;
			transform: rotate(135deg);
		}
	}
</style>
